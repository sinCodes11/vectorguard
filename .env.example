# Database configuration
# IMPORTANT: Change these credentials before deploying to production!
DATABASE_URL=postgresql+psycopg2://vectorguard:YOUR_SECURE_PASSWORD@localhost:5433/vectorguard
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD

# Redis configuration
REDIS_URL=redis://localhost:6379

# Security
# Generate a new secret key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECRET_KEY_CHANGE_THIS

# Authentication (set to "true" to require authentication on protected endpoints)
REQUIRE_AUTH=false

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# ChromaDB settings
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Logging
LOG_LEVEL=INFO

# API settings
CVE_API_RATE_LIMIT=100
ADVISORY_SOURCES=json

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384